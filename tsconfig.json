{
  "extends": [
    "@phanect/configs/ts",
    "astro/tsconfigs/base",
  ],
  "compilerOptions": {
    "paths": {
      "@layouts/*": [ "src/layouts/*" ],
      "@assets/*": [ "src/assets/*" ],
      "@data/*": [ "src/data/*" ],
      "@styles/*": [ "src/styles/*" ],
      "@components/*": [ "src/components/*" ],
      "@js/*": [ "src/js/*" ]
    },
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
